{
  "name": "bdh-query-rewrite-goldenset",
  "version": 2,
  "description": "Curated Italian/English evaluation set for BDH rewrite routing. Expected labels are human-authored; anchors are semantic retrieval checks. IDs are unique across all 100 cases.",
  "size": 100,
  "fields": {
    "should_retrieve": "Whether the current turn should perform BDH read retrieval.",
    "store_candidate": "Whether the turn contains a durable knowledge candidate for the write path.",
    "anchors": "Lower-case concepts expected in the rewritten query or retrieved evidence.",
    "max_sub_queries": "Upper bound for genuinely independent retrieval sub-queries."
  },
  "items": [
